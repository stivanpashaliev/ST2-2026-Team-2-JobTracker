@using ST2_2026_Team_2_JobTracker.Models.ViewModels.AiMatch
@using ST2_2026_Team_2_JobTracker.Models.Enums
@model AiMatchViewModel

@{
    ViewData["Title"] = "AI Job Match";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>AI Job Match</h2>
        <p class="text-muted mb-0">Compare your skills and experience with a saved job offer.</p>
    </div>
    <a asp-controller="JobOffers" asp-action="Index" class="btn btn-outline-secondary">Job offers</a>
</div>

@if (Model.JobOffers.Count == 0)
{
    <div class="alert alert-info" role="status">
        No job offers yet. <a asp-controller="JobOffers" asp-action="Create" class="alert-link">Create a job offer</a>
        to start using AI Match.
    </div>
}
else
{
    <form asp-controller="AiMatch" asp-action="Index" method="post" class="card shadow-sm mb-4">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>

            <div class="mb-3">
                <label asp-for="JobOfferId" class="form-label"></label>
                <select asp-for="JobOfferId" asp-items="Model.JobOffers" class="form-select">
                    <option value="0">Select job offer</option>
                </select>
                <span asp-validation-for="JobOfferId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SkillsAndExperience" class="form-label"></label>
                <textarea asp-for="SkillsAndExperience" class="form-control" rows="5"
                          maxlength="3000" placeholder="Example: C#, ASP.NET Core MVC, EF Core, SQL Server, Git. One year of practice projects."></textarea>
                <span asp-validation-for="SkillsAndExperience" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Mode" class="form-label"></label>
                <select asp-for="Mode" asp-items="Html.GetEnumSelectList<MatchingMode>()" class="form-select"></select>
                <span asp-validation-for="Mode" class="text-danger"></span>
                <div class="form-text">Gemini sends the selected job description and your profile to Google. Rule-based works offline.</div>
            </div>

            <button type="submit" class="btn btn-primary">Analyze Match</button>
        </div>
    </form>
}

@if (Model.Result is { } result)
{
    <section class="card shadow-sm" aria-label="Matching analysis">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h3 class="h4 mb-0">Match analysis</h3>
                <span class="badge bg-secondary">@result.Source</span>
            </div>
            <div class="d-flex align-items-center gap-3 mb-3">
                <span class="display-6 fw-semibold">@result.Score%</span>
                <div class="progress flex-grow-1" role="progressbar" aria-label="Match score"
                     aria-valuenow="@result.Score" aria-valuemin="0" aria-valuemax="100" style="height: 14px;">
                    <div class="progress-bar" style="width: @(result.Score)%"></div>
                </div>
            </div>
            <p class="text-muted small">Estimated match, not a probability of being hired.
                Rule-based mode only compares recognized technology keywords.</p>
            <p>@result.Summary</p>
            <div class="row g-4">
                <div class="col-lg-4">
                    <h4 class="h6 text-success">Matching skills</h4>
                    @if (result.MatchingSkills.Count == 0)
                    {
                        <p class="text-muted">None identified.</p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var item in result.MatchingSkills)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    }
                </div>
                <div class="col-lg-4">
                    <h4 class="h6 text-warning">Missing skills</h4>
                    @if (result.MissingSkills.Count == 0)
                    {
                        <p class="text-muted">None identified.</p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var item in result.MissingSkills)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    }
                </div>
                <div class="col-lg-4">
                    <h4 class="h6">Recommendations</h4>
                    @if (result.Recommendations.Count == 0)
                    {
                        <p class="text-muted">No recommendations.</p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var item in result.Recommendations)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
