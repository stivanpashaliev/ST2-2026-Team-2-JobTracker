
@model JobOfferIndexViewModel

@{
    ViewData["Title"] = "Job Offers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Job Offers</h2>

    <a asp-action="Create" class="btn btn-primary">
        Add Job Offer
    </a>
</div>

<form asp-action="Index" method="get" class="row g-3 mb-4">

    <div class="col-md-3">
        <label asp-for="Title" class="form-label">Job Title</label>
        <input asp-for="Title"
               class="form-control"
               placeholder="Search by title..." />
    </div>

    <div class="col-md-3">
        <label asp-for="CompanyId" class="form-label">Company</label>
        <select asp-for="CompanyId"
                asp-items="Model.Companies"
                class="form-select">
            <option value="">All Companies</option>
        </select>
    </div>

    <div class="col-md-3">
        <label asp-for="Location" class="form-label">Location</label>
        <input asp-for="Location"
               class="form-control"
               placeholder="Search by location..." />
    </div>

    <div class="col-md-3">
        <label asp-for="RemoteType" class="form-label">Work Type</label>
        <select asp-for="RemoteType"
                asp-items="Html.GetEnumSelectList<ST2_2026_Team_2_JobTracker.Models.Enums.RemoteType>()"
                class="form-select">
            <option value="">All Types</option>
        </select>
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            Search
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Clear
        </a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Title</th>
                <th>Company</th>
                <th>Location</th>
                <th>Salary</th>
                <th>Work Type</th>
                <th>Created At</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.JobOffers.Any())
            {
                @foreach (var jobOffer in Model.JobOffers)
                {
                    <tr>
                        <td>@jobOffer.Title</td>
                        <td>@jobOffer.Company.Name</td>
                        <td>@(jobOffer.Location ?? "-")</td>
                        <td>
                            @(jobOffer.Salary.HasValue
                                ? jobOffer.Salary.Value.ToString("N2")
                                : "-")
                        </td>
                        <td>@jobOffer.RemoteType</td>
                        <td>@jobOffer.CreatedAt.ToString("dd.MM.yyyy")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">
                        No job offers found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
