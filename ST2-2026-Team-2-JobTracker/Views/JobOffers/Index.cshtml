
@model JobOfferIndexViewModel

@{
    ViewData["Title"] = "Job Offers";
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Job Offers</h2>

    <a asp-action="Create" class="btn btn-primary">
        Add Job Offer
    </a>
</div>

<form asp-action="Index" method="get" class="row g-3 mb-4">

    <div class="col-md-3">
        <label asp-for="Title" class="form-label">Job Title</label>
        <input asp-for="Title"
               class="form-control"
               placeholder="Search by title..." />
    </div>

    <div class="col-md-3">
        <label asp-for="CompanyId" class="form-label">Company</label>
        <select asp-for="CompanyId"
                asp-items="Model.Companies"
                class="form-select">
            <option value="">All Companies</option>
        </select>
    </div>

    <div class="col-md-3">
        <label asp-for="Location" class="form-label">Location</label>
        <input asp-for="Location"
               class="form-control"
               placeholder="Search by location..." />
    </div>

    <div class="col-md-3">
        <label asp-for="RemoteType" class="form-label">Work Type</label>
        <select asp-for="RemoteType"
                asp-items="Html.GetEnumSelectList<ST2_2026_Team_2_JobTracker.Models.Enums.RemoteType>()"
                class="form-select">
            <option value="">All Types</option>
        </select>
    </div>

<div class="col-md-3">
    <label asp-for="MinSalary" class="form-label">
        Minimum Salary
    </label>
    <input asp-for="MinSalary"
           type="number"
           min="0"
           step="0.01"
           class="form-control"
           placeholder="Min salary" />
</div>

<div class="col-md-3">
    <label asp-for="MaxSalary" class="form-label">
        Maximum Salary
    </label>
    <input asp-for="MaxSalary"
           type="number"
           min="0"
           step="0.01"
           class="form-control"
           placeholder="Max salary" />
</div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            Search
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Clear
        </a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Title</th>
                <th>Company</th>
                <th>Location</th>
                <th>Salary</th>
                <th>Work Type</th>
                <th>Created At</th>
                    <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.JobOffers.Any())
            {
                @foreach (var jobOffer in Model.JobOffers)
                {
                    <tr>
                        <td>@jobOffer.Title</td>
                        <td>@jobOffer.Company.Name</td>
                        <td>@(jobOffer.Location ?? "-")</td>
                        <td>
                            @(jobOffer.Salary.HasValue
                                ? jobOffer.Salary.Value.ToString("N2")
                                : "-")
                        </td>
                        <td>@jobOffer.RemoteType</td>
                        <td>@jobOffer.CreatedAt.ToString("dd.MM.yyyy")</td>
                        <td class="text-nowrap">
                            <a asp-action="Edit" asp-route-id="@jobOffer.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@jobOffer.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center">
                        No job offers found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalCount > 0)
{
    <div class="text-muted mb-3">
        Total job offers: @Model.TotalCount
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav aria-label="Job offers pagination">
        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-title="@Model.Title"
                   asp-route-companyId="@Model.CompanyId"
                   asp-route-location="@Model.Location"
                   asp-route-remoteType="@Model.RemoteType"
                   asp-route-minSalary="@Model.MinSalary"
                   asp-route-maxSalary="@Model.MaxSalary"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   aria-disabled="@(Model.CurrentPage == 1)"
                   tabindex="@(Model.CurrentPage == 1 ? -1 : 0)">
                    Previous
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-title="@Model.Title"
                       asp-route-companyId="@Model.CompanyId"
                       asp-route-location="@Model.Location"
                       asp-route-remoteType="@Model.RemoteType"
                       asp-route-minSalary="@Model.MinSalary"
                       asp-route-maxSalary="@Model.MaxSalary"
                       asp-route-page="@i"
                       aria-current="@(i == Model.CurrentPage ? "page" : null)">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-title="@Model.Title"
                   asp-route-companyId="@Model.CompanyId"
                   asp-route-location="@Model.Location"
                   asp-route-remoteType="@Model.RemoteType"
                   asp-route-minSalary="@Model.MinSalary"
                   asp-route-maxSalary="@Model.MaxSalary"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   aria-disabled="@(Model.CurrentPage == Model.TotalPages)"
                   tabindex="@(Model.CurrentPage == Model.TotalPages ? -1 : 0)">
                    Next
                </a>
            </li>

        </ul>
    </nav>
}
