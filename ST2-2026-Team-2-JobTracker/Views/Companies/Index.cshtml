
@model CompanyIndexViewModel

@{
    ViewData["Title"] = "Companies";
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Companies</h2>

    <a asp-action="Create" class="btn btn-primary">
        Add Company
    </a>
</div>

<form asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-md-5">
        <label asp-for="Name" class="form-label">Company Name</label>
        <input asp-for="Name"
               class="form-control"
               placeholder="Search by name..." />
    </div>

    <div class="col-md-5">
        <label asp-for="Location" class="form-label">Location</label>
        <input asp-for="Location"
               class="form-control"
               placeholder="Search by location..." />
    </div>

    <div class="col-md-2 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary">
            Search
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Clear
        </a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Website</th>
            <th>Location</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model.Companies.Any())
        {
            @foreach (var company in Model.Companies)
            {
                <tr>
                    <td>@company.Name</td>
                    <td>@company.Website</td>
                    <td>@company.Location</td>
                    <td class="text-nowrap">
                        <a asp-action="Edit" asp-route-id="@company.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@company.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">
                    No companies found.
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalCount > 0)
{
    <div class="text-muted mb-3">
        Total companies: @Model.TotalCount
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav aria-label="Companies pagination">
        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-name="@Model.Name"
                   asp-route-location="@Model.Location"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   aria-disabled="@(Model.CurrentPage == 1)"
                   tabindex="@(Model.CurrentPage == 1 ? -1 : 0)">
                    Previous
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-name="@Model.Name"
                       asp-route-location="@Model.Location"
                       asp-route-page="@i">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-name="@Model.Name"
                   asp-route-location="@Model.Location"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   aria-disabled="@(Model.CurrentPage == Model.TotalPages)"
                   tabindex="@(Model.CurrentPage == Model.TotalPages ? -1 : 0)">
                    Next
                </a>
            </li>

        </ul>
    </nav>
}
