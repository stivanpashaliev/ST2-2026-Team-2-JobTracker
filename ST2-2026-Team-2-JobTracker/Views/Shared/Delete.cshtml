@model ST2_2026_Team_2_JobTracker.Models.ViewModels.DeleteViewModel

@{
    ViewData["Title"] = $"Delete {Model.EntityName}";
}

<h2>Delete @Model.EntityName</h2>
<p><strong>@Model.DisplayName</strong></p>

@if (Model.BlockingMessage != null)
{
    <div class="alert alert-warning" role="alert">@Model.BlockingMessage</div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
}
else
{
    <p>Are you sure you want to delete this @Model.EntityName.ToLowerInvariant()? This cannot be undone.</p>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
}
